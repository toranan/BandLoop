{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/", "destination": "/Website/index.html" },
    { "source": "/support", "destination": "/Website/support.html" },
    { "source": "/privacy", "destination": "/Website/privacy.html" },
    { "source": "/styles.css", "destination": "/Website/styles.css" },
    { "source": "/script.js", "destination": "/Website/script.js" },
    { "source": "/robots.txt", "destination": "/Website/robots.txt" },
    { "source": "/sitemap.xml", "destination": "/Website/sitemap.xml" },
    { "source": "/assets/(.*)", "destination": "/Website/assets/$1" }
  ]
}
